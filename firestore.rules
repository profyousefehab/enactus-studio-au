rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: goldenQuestions
    // Document ID: 'active' or historical question ID (e.g., 'gq_1711000000000')
    // Fields:
    //   - questionId: string - unique identifier for the question instance
    //   - question: string - question prompt text
    //   - options: list of strings - multiple choice options
    //   - correctIndex: number - index of correct option
    //   - points: number - reward points for solving
    //   - isActive: bool - whether the quiz question is currently active/unsolved
    //   - attemptedBy: list of strings - member user IDs who made wrong attempts
    //   - winnerId: string | null - user ID of member who solved it first, or null
    //   - winnerName: string | null - display name of winner, or null
    //   - winnerAvatarId: string | null (optional) - avatar identifier of winner
    //   - winnerCustomAvatarUrl: string | null (optional) - custom avatar image URL or base64 data URI (50KB+)
    //   - winnerTrack: string | null (optional) - track of winner ('Design' | 'Content')
    //   - solvedAt: timestamp | null - timestamp when question was solved, or null
    //   - createdAt: timestamp | null (optional) - timestamp when question was launched
    //   - cancelledAt: timestamp | null (optional) - timestamp when question was cancelled
    //
    // Existing Collections:
    //   - users/{userId}
    //   - wallPosts/{postId} (and comments/{commentId})
    //   - pointEvents/{eventId}
    //   - attendance/{attId}
    //   - sessionFeedbackResponses/{responseId}
    //   - settings/{docId}
    //
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.pinCode is string
                    && request.resource.data.pinCode.size() == 4
                    && (request.resource.data.role == 'member' || request.resource.data.role == 'hr');
      allow update: if true;
      allow delete: if true;
    }

    match /wallPosts/{postId} {
      allow read, create, update: if true;
      allow delete: if true;

      match /comments/{commentId} {
        allow read, create: if true;
      }
    }

    match /pointEvents/{eventId} {
      allow read, create: if true;
    }

    match /attendance/{attId} {
      allow read, create, update, delete: if true;
    }

    match /sessionFeedbackResponses/{responseId} {
      allow read, create: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /goldenQuestions/{docId} {
      allow read, write: if true;
    }
  }
}
